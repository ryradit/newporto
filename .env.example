# ==============================================================================
# Google Gemini & Genkit Configuration
# ==============================================================================
# Required: API key for Gemini models (Chatbot, Recruiter Agent, Translations, Genkit)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Required: Supabase credentials for storing agent leads & chat interactions
# Find these in your Supabase project settings: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==============================================================================
# Web3Forms Configuration (Interview Booking & Contact Form)
# ==============================================================================
# Required: Access key for interview request form submissions
# Get a free access key from https://web3forms.com/
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# ==============================================================================
# Resend Email Configuration (Optional / Recommended)
# ==============================================================================
# API key to send automated email notifications when a lead qualifies
# Get your key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# ==============================================================================
# Google Calendar Integration (Optional)
# ==============================================================================
# Used by Scheduler Agent for live availability checks and appointment scheduling
GOOGLE_CALENDAR_API_KEY=your_google_calendar_api_key_here
GOOGLE_CALENDAR_ID=ryradit@gmail.com
GOOGLE_CALENDAR_BOOKING_LINK=https://calendar.google.com/calendar/u/0/r
GOOGLE_CALENDAR_REFERER=https://ryradit.my.id/

# ==============================================================================
# VAPI Voice Assistant Configuration (Optional)
# ==============================================================================
# API key for real-time voice call features with the AI assistant
# Get your key from https://vapi.ai/
NEXT_PUBLIC_VAPI_API_KEY=your_vapi_api_key_here
